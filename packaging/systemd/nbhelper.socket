# CrossWax NasBuster — privileged helper socket. systemd starts nbhelper on the
# first connection; the helper exits when idle, so it costs no RAM most of the time.
[Unit]
Description=CrossWax NasBuster privileged helper socket

[Socket]
ListenStream=/run/cwnsb/helper.sock
SocketUser=root
SocketGroup=cwnsb
SocketMode=0660
DirectoryMode=0755
Accept=no

[Install]
WantedBy=sockets.target
