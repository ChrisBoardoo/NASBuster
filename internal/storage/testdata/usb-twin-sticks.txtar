-- udevadm /dev/sda --
DEVPATH=/devices/platform/axi/1000120000.pcie/1f00200000.usb/xhci-hcd.0/usb2/2-1/2-1:1.0/host1/target1:0:0/1:0:0:0/block/sda
DEVNAME=/dev/sda
DEVTYPE=disk
MAJOR=8
MINOR=0
SUBSYSTEM=block
ID_BUS=usb
ID_MODEL=Flash_Disk
ID_MODEL_ID=6387
ID_SERIAL=Generic_Flash_Disk_FBA81234-0:0
ID_SERIAL_SHORT=FBA81234
ID_TYPE=disk
ID_VENDOR=Generic
ID_VENDOR_ID=058f
ID_INSTANCE=0:0
ID_USB_VENDOR_ID=058f
ID_USB_MODEL_ID=6387
ID_USB_DRIVER=usb-storage
ID_PATH=platform-xhci-hcd.0-usb-0:1:1.0-scsi-0:0:0:0
DEVLINKS=/dev/disk/by-id/usb-Generic_Flash_Disk_FBA81234-0:0 /dev/disk/by-path/platform-xhci-hcd.0-usb-0:1:1.0-scsi-0:0:0:0 /dev/disk/by-diskseq/9
